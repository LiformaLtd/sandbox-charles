{
	"name": "phonom-tts",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"fetch:models": "node scripts/fetch-models.mjs",
		"dev": "vite dev",
