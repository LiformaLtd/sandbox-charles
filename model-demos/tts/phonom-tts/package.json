		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@huggingface/transformers": "4.3.2",
		"onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
		"phonon-tts": "0.6.0"
