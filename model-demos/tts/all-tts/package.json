{
  "name": "all-tts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/build-browser-tokenizer.mjs && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:tokenizer": "node scripts/test-browser-tokenizer.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sctg/sentencepiece-js": "1.3.3",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "onnxruntime-node": "^1.31.1",
    "onnxruntime-web": "1.31.1",
    "phonon-tts": "0.6.0"
  }
}
